---
import { Image } from "astro:assets";
import Logo from "../static/logo.png";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
	getTranslations,
	localeRepresentation,
	LOCALES,
	type Locale,
} from "../i18n/lib";
import { MoonIcon, SunIcon } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { TECH_ICONS } from "../constants";
import clsx from "clsx";

interface Props {
	locale: Locale;
}

const props = Astro.props;
---

<header
	class="h-14 lg:h-16 bg-amber-100 dark:bg-stone-900 border-t border-amber-300 dark:border-stone-700 flex items-center gap-7 my-4 xl:my-6 mx-auto max-w-2xl px-5 lg:px-6 rounded-full text-stone-900 dark:text-stone-200 lg:*:opacity-80 dark:lg:*:opacity-70 *:hover:opacity-100 *:transition-all *:duration-300 *:font-bold"
>
	<a
		href={getRelativeLocaleUrl(props.locale, "/")}
		class="size-12 lg:size-14 -mx-2 invert-100 dark:invert-0"
	>
		<Image src={Logo} alt="Home" />
	</a>

	<div class="h-2/3 w-px bg-amber-200 dark:bg-stone-700"></div>

	<a href="https://github.com/chakram9000" target="_blank">
		<Icon name={TECH_ICONS["github"]} class="size-6" />
	</a>

	<button id="theme-switch" class="hover:cursor-pointer">
		<MoonIcon class="block dark:hidden fill-stone-900" />
		<SunIcon class="hidden dark:block" />
	</button>

	{
		LOCALES.filter((l) => l !== props.locale).map((l) => (
			<a
				href={getRelativeLocaleUrl(l, "/")}
				class={clsx("text-xl", l === "ar" && "pb-1")}
			>
				{localeRepresentation(l)}
			</a>
		))
	}
</header>
<script>
	const btn = document.getElementById("theme-switch") as HTMLButtonElement;
	btn.addEventListener("click", () => {
		document.querySelector("body")!.classList.toggle("dark");
		localStorage.setItem(
			"light",
			`${!document.querySelector("body")!.classList.contains("dark")}`,
		);
	});
</script>
