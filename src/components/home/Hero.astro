---
import { Image } from "astro:assets";
import { getTranslations, type Locale } from "../../i18n/lib";
import heroImage from "../../static/hero2.jpg";

interface Props {
	locale: Locale;
}

const props = Astro.props;
const t = getTranslations(props.locale);
---

<section class="flex flex-col gap-4 items-stretch">
	<div class="rounded-xl overflow-hidden shadow">
		<img
			src="/hero.webp"
			alt=""
			class="opacity-90 dark:opacity-80 w-full h-32 md:h-40 lg:h-56 object-cover object-[0%_25%]"
		/>
	</div>

	<h1>{t["home.hero.hello"]}</h1>

	<div
		class="flex-1 flex flex-col gap-5 rtl:text-justify font-light leading-7 lg:leading-6.5"
	>
		<p>{t["home.hero.p1"]} {t["home.hero.p2"]}</p>
		<p>{t["home.hero.p3"]}</p>
		<p>{t["home.hero.p4"]}</p>
	</div>

	<p
		class="ps-2 lg:ps-3 border-s-2 border-sky-600 dark:border-emerald-800 text-lg lg:text-xl"
	>
		{t["home.hero.contact.email"]}:
		<span class="ms-2">
			<a href="mailto:barid@chakram.xyz" class="link">barid@chakram.xyz</a>
		</span>
	</p>
</section>
