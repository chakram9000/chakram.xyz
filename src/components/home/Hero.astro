---
import { getTranslations, type Locale } from "../../i18n/lib";

interface Props {
	locale: Locale;
}

const props = Astro.props;
const t = getTranslations(props.locale);
---

<section class="flex flex-col gap-1 [&_p]:text-lg">
	<h1 class="text-3xl mb-1">{t["home.hero.hello"]}</h1>
	<p class="mb-1">{t["home.hero.p1"]}</p>
	<p>{t["home.hero.p2"]}</p>
	<p>{t["home.hero.p3"]}</p>
	<p>{t["home.hero.p4"]}</p>
</section>
