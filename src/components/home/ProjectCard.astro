---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { TECH_ICONS, type Technology } from "../../constants.ts";
import { Icon } from "astro-icon/components";

interface Props {
	img: ImageMetadata;
	title: string;
	desc: string;
	cardURL?: string; // if undefined, will be set to githubURL
	githubURL: string;
	techUsed: Technology[];
}

const props = Astro.props;
if (!props.cardURL) props.cardURL = props.githubURL;
---

<div
	class="flex flex-col items-stretch max-w-72 rounded-lg border-2 border-stone-800 hover:border-stone-700 group"
>
	<a
		href={props.cardURL}
		target="_blank"
		class="h-24 overflow-hidden rounded-t-lg"
	>
		<Image
			src={props.img}
			alt="project image"
			class="opacity-50 group-hover:opacity-100 transition-opacity max-w-full"
		/>
	</a>

	<div class="flex-1 flex flex-col p-3">
		<h2 class="text-lg font-bold">{props.title}</h2>
		<p class="text-md">{props.desc}</p>
	</div>

	<div class="flex flex-wrap gap-3 items-center p-3">
		<a href={props.githubURL} target="_blank" class="me-auto">
			<Icon name={TECH_ICONS["github"]} class="size-6" />
		</a>

		{
			props.techUsed.map((tech) => (
				<Icon name={TECH_ICONS[tech]} class="size-4" />
			))
		}
	</div>
</div>
