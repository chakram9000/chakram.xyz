---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { TECH_ICONS, type Technology } from "../../constants.ts";
import { Icon } from "astro-icon/components";
import clsx from "clsx";
import { getTranslations, type Locale } from "../../i18n/lib";

// @TODO: redesign this to be more modular.
type Props = {
	locale: Locale;
	img: ImageMetadata;
	title: string;
	desc: string;
	cardURL?: string; // if undefined, will be set to githubURL
	githubURL?: string;
	isProfessional?: boolean;
	techUsed: Technology[];
};

const props = Astro.props;
if (!props.cardURL && props.githubURL) props.cardURL = props.githubURL;

const t = getTranslations(props.locale);
---

<div
	class={clsx(
		"flex flex-col items-stretch rounded-lg overflow-hidden border-2 group bg-white dark:bg-stone-900",
		props.isProfessional
			? "border-sky-500 lg:border-sky-200 lg:hover:border-sky-500 dark:border-emerald-600 dark:lg:border-emerald-800 dark:lg:hover:border-emerald-600 relative"
			: "border-amber-100 hover:border-amber-300 dark:border-stone-800 dark:hover:border-stone-700",
	)}
>
	{
		props.isProfessional && (
			<div class="absolute w-full z-10 bg-sky-500 dark:bg-emerald-600 text-white dark:text-stone-100 transition-all py-1.5 md:py-0 group-hover:py-1.5">
				<p class="md:hidden group-hover:block text-xs lg:text-sm font-bold text-center">
					{t["projects.professional"]}
				</p>
			</div>
		)
	}

	<a href={props.cardURL ?? "#"} target="_blank" class="h-32 overflow-hidden">
		<Image
			src={props.img}
			alt="project image"
			class="lg:opacity-90 dark:lg:opacity-50 group-hover:opacity-100 transition-opacity max-w-full"
		/>
	</a>

	<div class="flex-1 flex flex-col p-2 lg:p-3">
		<h2 class="text-base lg:text-lg font-bold my-1">{props.title}</h2>
		<p class="text-sm lg:text-base rtl:text-justify">{props.desc}</p>
	</div>

	<div
		class="flex flex-wrap gap-2 lg:gap-3 items-center justify-end p-2 lg:p-3"
	>
		{
			props.githubURL && (
				<a href={props.githubURL} target="_blank" class="me-auto">
					<Icon name={TECH_ICONS["github"]} class="size-6" />
				</a>
			)
		}
		{
			props.techUsed.map((tech) => (
				<Icon name={TECH_ICONS[tech]} class="size-4" />
			))
		}
	</div>
</div>
