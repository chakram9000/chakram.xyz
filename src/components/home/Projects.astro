---
import { getTranslations, type Locale } from "../../i18n/lib";
import ProjectCard from "./ProjectCard.astro";
import KhizanahIMG from "../../static/projects/khizanah.png";
import MinidriveIMG from "../../static/projects/minidrive.png";
import CellularIMG from "../../static/projects/cellautomata.png";
import ForoqIMG from "../../static/projects/foroq.png";

interface Props {
	locale: Locale;
}

const props = Astro.props;
const t = getTranslations(props.locale);
---

<section class="flex flex-col gap-8">
	<h1>{t["projects.title"]}</h1>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
		<ProjectCard
			locale={props.locale}
			img={ForoqIMG}
			title={t["projects.foroq.title"]}
			desc={t["projects.foroq.desc"]}
			cardURL="https://foroq.com/"
			techUsed={["astro", "tailwindcss", "express", "zoho", "cloudflare"]}
			isProfessional
		/>
		<ProjectCard
			locale={props.locale}
			img={KhizanahIMG}
			title={t["projects.khizanah.title"]}
			desc={t["projects.khizanah.desc"]}
			githubURL="https://github.com/chakram9000/khizanah-app"
			techUsed={["python", "qt"]}
		/>
		<ProjectCard
			locale={props.locale}
			img={MinidriveIMG}
			title={t["projects.minidrive.title"]}
			desc={t["projects.minidrive.desc"]}
			githubURL="https://github.com/chakram9000/minidrive"
			techUsed={["js", "express", "postgresql", "prisma", "ejs"]}
		/>
		<ProjectCard
			locale={props.locale}
			img={CellularIMG}
			title={t["projects.cellular.title"]}
			desc={t["projects.cellular.desc"]}
			githubURL="https://github.com/chakram9000/c_cellular_automata"
			techUsed={["c", "raylib"]}
		/>
	</div>
</section>
