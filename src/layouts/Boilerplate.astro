---
import { type Locale } from "../i18n/lib";
import "../static/style.css";

interface Props {
	title: string;
	locale: Locale;
}

const props = Astro.props;
---

<html lang={props.locale} dir={props.locale === "ar" ? "rtl" : "ltr"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/gif" href="/worker.gif" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>chakram.xyz | {props.title}</title>
	</head>
	<body class="bg-stone-950 flex flex-col items-stretch">
		<main
			class="bg-stone-900 mx-auto max-w-2xl w-11/12 flex flex-col items-stretch border border-stone-700 *:p-8 *:border-b *:border-b-stone-700"
		>
			<slot />
		</main>
	</body>
</html>
