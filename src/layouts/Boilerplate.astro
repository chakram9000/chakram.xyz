---
import { Font } from "astro:assets";
import { type Locale } from "../i18n/lib";
import "../static/style.css";
import Header from "../components/Header.astro";

interface Props {
	title: string;
	locale: Locale;
}

const props = Astro.props;
---

<html lang={props.locale} dir={props.locale === "ar" ? "rtl" : "ltr"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/gif" href="/worker.gif" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-readex-pro" />
		<title>chakram.xyz | {props.title}</title>
	</head>
	<body
		class="bg-stone-950 flex flex-col items-stretch rtl:font-(family-name:--font-readex-pro)"
	>
		<main
			class="bg-stone-900 flex flex-col items-stretch border border-stone-700 mx-auto my-4 sm:my-6 lg:my-8 max-w-4xl w-11/12 *:p-4 sm:*:p-6 lg:*:p-8 *:border-b *:border-b-stone-700 shadow-2xl shadow-white/10"
		>
			<slot />
		</main>
	</body>
</html>
