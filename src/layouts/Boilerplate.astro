---
import { Font } from "astro:assets";
import { type Locale } from "../i18n/lib";
import "../static/style.css";
import Header from "../components/Header.astro";

interface Props {
	title: string;
	locale: Locale;
}

const props = Astro.props;
---

<html lang={props.locale} dir={props.locale === "ar" ? "rtl" : "ltr"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/gif" href="/worker.gif" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-schehrazade" />
		<title>chakram.xyz | {props.title}</title>
	</head>
	<body
		class="bg-stone-950 flex flex-col items-stretch rtl:font-[--font-schehrazade]"
	>
		<Header locale={props.locale} />
		<main
			class="bg-stone-900 flex flex-col items-stretch border border-stone-700 mx-auto max-w-4xl w-11/12 *:p-8 *:border-b *:border-b-stone-700 shadow-2xl shadow-white/20"
		>
			<slot />
		</main>
	</body>
</html>
