---
import { Font } from "astro:assets";
import { type Locale } from "../i18n/lib";
import "../static/style.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
	title: string;
	locale: Locale;
}

const props = Astro.props;
---

<html lang={props.locale} dir={props.locale === "ar" ? "rtl" : "ltr"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/gif" href="/worker.gif" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-readex-pro" />
		<title>chakram.xyz | {props.title}</title>
	</head>
	<body
		class="bg-amber-200 dark:bg-stone-950 text-stone-700 dark:text-stone-200 flex flex-col items-stretch rtl:font-(family-name:--font-readex-pro)"
	>
		<Header locale={props.locale} />
		<main
			class="bg-amber-100 dark:bg-stone-900 flex flex-col items-stretch dark:border dark:border-stone-700 mx-auto mb-6 lg:mb-8 max-w-4xl w-11/12 *:p-4 sm:*:p-6 lg:*:p-8 *:border-b *:border-b-amber-300 dark:*:border-b-stone-700 md:shadow-2xl shadow-stone-900/20 dark:shadow-stone-100/10"
		>
			<slot />
		</main>
		<Footer locale={props.locale} />
	</body>
</html>
